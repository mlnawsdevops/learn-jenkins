pipeline {
    agent any
    stages {
        stage('code'){
            steps {
                sh 'echo This is code'
            }
        }
        stage('build'){
            steps{
                sh 'echo This is build'
            }
        }
        stage('test'){
            steps{
                sh 'echo This is test'
            }
        }
        stage('deploy'){
            steps{
                sh 'echo This is deploy'
            }
        }
    }
}